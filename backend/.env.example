# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revenue_treasury"
PGHOST=localhost
PGPORT=5432
PGDATABASE=revenue_treasury
PGUSER=postgres
PGPASSWORD=postgres

# Server & JWT
PORT=3000
JWT_SECRET=municipal-treasury-secret-key-9988

# ================================================================
# EMAIL OTP CONFIGURATION (HTTPS REST API - Recommended for Railway)
# ================================================================
# Option A: Brevo (Sendinblue) - 300 free emails/day to any recipient
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option B: Resend - 3,000 free emails/month
# RESEND_API_KEY=re_your_resend_api_key_here

# Sender Configuration
SMTP_USER=govserve.treasury@gmail.com
SMTP_FROM="GovServe Treasury <govserve.treasury@gmail.com>"

# ================================================================
# Fallback Nodemailer / Gmail SMTP Configuration (Local development)
# ================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_PASS=your_gmail_app_password_here

